  min-height: 34px;
  padding: 0 14px;
  font-size: 12px;
}
.filter-bar {
  display: flex;
  align-items: end;
  gap: 10px;
  margin-bottom: 14px;
  padding: 13px 14px;
  overflow: visible;
}
.search-field {
  display: flex;
  min-width: 260px;
  min-height: 37px;
  flex: 1;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  color: #5595c6;
  background: rgb(2 23 57 / 52%);
  border: 1px solid rgb(65 150 222 / 23%);
  border-radius: 4px;
}
.search-field input {
  width: 100%;
  color: #d9edff;
  background: transparent;
  border: 0;
  outline: 0;
  font: inherit;
  font-size: 11px;
}
.search-field input::placeholder {
  color: #4c7196;
}
.filter-field {
  display: grid;
  min-width: 125px;
  gap: 5px;
}
.filter-field > span {
  color: #648caf;
  font-size: 9px;
}
.dashboard-select {
  min-height: 37px;
  color: #bad4e9;
  border-radius: 4px;
  font: inherit;
  font-size: 11px;
  color-scheme: dark;
}
.dashboard-select :deep(.q-field__control) {
  min-height: 42px;
  height: 42px;
  color: #bad4e9;
  background: #061f45;
  border-radius: 4px;
}
.dashboard-select :deep(.q-field__control::before) {
  border-color: rgb(65 150 222 / 23%);
}
.dashboard-select :deep(.q-field__native),
.dashboard-select :deep(.q-field__input),
.dashboard-select :deep(.q-field__marginal) {
  min-height: 42px;
  height: 42px;
  color: #bad4e9;
  font-size: 11px;
}
.dashboard-select :deep(.q-field__native) {
  padding: 0 0 0 10px;
}
:global(.dashboard-select-popup) {
  color: #c9def0;
  background: #0a3768;
  border: 1px solid rgb(66 174 239 / 38%);
  border-radius: 3px;
  box-shadow: 0 12px 30px rgb(0 8 28 / 48%);
}
:global(.dashboard-select-popup .q-item) {
  min-height: 38px;
  color: #c9def0;
  font-size: 13px;
}
:global(.dashboard-select-popup .q-item:hover:not(.q-item--active)) {
  background: #0d477e;
}
:global(.dashboard-select-popup .q-item--active),
:global(.dashboard-select-popup .q-item[aria-selected='true']) {
  color: #fff !important;
  background: #02142f !important;
  font-weight: 600;
}
:global(.dashboard-select-popup .q-item[aria-selected='false'].q-manual-focusable--focused) {
  background: #0d477e !important;
}
:global(.dashboard-select-popup .q-item .q-focus-helper) {
  display: none !important;
}
.filter-button {
  min-height: 37px;
  padding: 0 13px;
  color: #8db6d7;
  background: rgb(14 77 139 / 35%);
  box-shadow: none;
  font-size: 11px;
}
.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 14px;
}
.metric-card {
  display: grid;
  min-height: 88px;
  grid-template-columns: 39px 1fr auto;
  align-items: center;
  gap: 12px;
  padding: 15px;
}
.metric-icon {
  display: grid;
  width: 39px;
  height: 39px;
  place-items: center;
  color: #67d7ff;
  background: rgb(21 126 222 / 17%);
  border: 1px solid rgb(63 178 245 / 24%);
  border-radius: 5px;
}
.metric-card div > span {
  display: block;
  color: #739abc;
  font-size: 10px;
}
.metric-card strong {
  display: block;
  margin-top: 3px;
  color: #fff;
  font-size: 23px;
  font-weight: 600;
}
.metric-card small {
  margin-left: 3px;
  color: #769aba;
  font-size: 10px;
  font-weight: 400;
}
.metric-card em {
  align-self: end;
  color: #4f789d;
  font-size: 9px;
  font-style: normal;
}
.metric-card em.positive {
  color: #39cda1;
}
.metric-card em.danger {
  color: #ff718b;
}
.metric-card em.info {
  color: #62c9f5;
}
.dashboard-grid {
  display: grid;
  grid-template-columns: 245px minmax(560px, 1fr) 260px;
  gap: 14px;
  margin-bottom: 14px;
}
.alert-panel,
.ranking-panel,
.map-panel {
  min-height: 530px;
}
.danger-count {
  display: grid;
  width: 22px;
  height: 22px;
  place-items: center;
  color: #ffb2be;
  background: rgb(237 59 90 / 18%);
  border: 1px solid rgb(255 103 126 / 26%);
