# 高德开放平台 Web JS API 2.0 Key
QCLI_AMAP_KEY=

# 仅建议本地开发使用；生产环境请使用高德安全代理配置
QCLI_AMAP_SECURITY_CODE=

# 真实项目数据接口；支持直接返回数组，或返回 { "data": [...] }
QCLI_PROJECT_API_URL=/api/projects

# MySQL（密码只填写在本机的 .env.local 中）
BIDDING_DB_HOST=127.0.0.1
BIDDING_DB_PORT=3306
BIDDING_DB_USER=root
BIDDING_DB_PASSWORD=
BIDDING_DB_NAME=bidding_system

# 模块2 AI+定额双驱动（兼容 OpenAI Chat Completions 接口）
# 当前已验证接口：https://c4ai.ccccltd.cn/api/compatible/v1 + jiaorong-kimi-k2.6
# DeepSeek也可使用：https://api.deepseek.com + deepseek-chat
# 本地Ollama示例：http://127.0.0.1:11434/v1 + qwen3:8b
COST_AI_ENABLED=true
COST_AI_BASE_URL=https://c4ai.ccccltd.cn/api/compatible/v1
COST_AI_MODEL=jiaorong-kimi-k2.6
COST_AI_API_KEY=
COST_AI_TIMEOUT=45
# 单次清单最多交给大模型复核的非精确匹配项目数，避免失控消费
COST_AI_MATCH_LIMIT=150
# 原AI工程造价系统的数据目录（目录变化时只需修改这里）
COST_DATA_ROOT=D:\AI工程造价系统
