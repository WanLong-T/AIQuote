{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@aiquote/shared": ["../../packages/shared/src/index.ts"],
      "@aiquote/shared/*": ["../../packages/shared/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"]
}
