{
  "name": "aiquote-frontend",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "AIQuote Frontend",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./apps/**/**/*.{ts,js,cjs,mjs,vue}\" \"./packages/**/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./apps/**/**/*.{ts,js,cjs,mjs,vue}\" \"./packages/**/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "npm run dev:portal",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:map": "npm --workspace @aiquote/national-project-map run dev",
    "dev:ai": "npm --workspace @aiquote/ai-cost-estimation run dev",
    "dev:template": "npm --workspace @aiquote/bid-template-analysis run dev",
    "dev:result": "npm --workspace @aiquote/bid-result-analysis run dev",
    "dev:portal": "npm --workspace @aiquote/portal run dev",
    "build": "npm --workspace @aiquote/portal run build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.0.2",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
