{
  "name": "aiquote-monorepo",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Bidding Decision System",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"platform/src/**/*.{js,ts,vue,css,scss}\" \"modules/**/*.vue\" && eslint --fix -c platform/eslint.config.js \"platform/src/**/*.{ts,js,vue}\" \"modules/**/*.vue\"",
    "lint:check": "prettier --check \"platform/src/**/*.{js,ts,vue,css,scss}\" \"modules/**/*.vue\" && eslint -c platform/eslint.config.js \"platform/src/**/*.{ts,js,vue}\" \"modules/**/*.vue\"",
    "dev": "cd platform && quasar dev -p 9001",
    "data:fetch": "node platform/scripts/fetch-jszb-projects.mjs",
    "data:sync": "node platform/scripts/sync-crawler-projects.mjs",
    "build": "cd platform && quasar build",
    "serve:lan": "node platform/scripts/serve-lan.mjs",
    "typecheck": "vue-tsc --noEmit -p platform/tsconfig.json",
    "postinstall": "cd platform && quasar prepare --silent"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@quasar/extras": "^2.1.0",
    "echarts": "^6.1.0",
    "mysql2": "^3.24.6",
    "pinia": "^4.0.2",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
